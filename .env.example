# URL base de la API. En producción (Render): https://proyectosita-es-backend.onrender.com/api
VITE_API_URL=http://localhost:3000/api

# ID de cliente OAuth de Google (botón "Continuar con Google"). Es público: no es un secreto.
# Debe ser el mismo GOOGLE_CLIENT_ID del backend. Es la única forma de entrar: sin él no se puede iniciar sesión.
VITE_GOOGLE_CLIENT_ID=609971080288-h4ukg49ic8h71rc3jvdidhcjkv3o58i6.apps.googleusercontent.com

# Formulario de correo y contraseña en /login. SOLO PARA DESARROLLO (cuentas de la semilla): necesita además
# LOGIN_CONTRASENA=true en el backend. Apagado por defecto (solo "true" lo enciende). En producción (Render) NO se define.
VITE_LOGIN_CONTRASENA=true
